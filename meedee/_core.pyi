from collections.abc import Callable
from types import ModuleType

from . import ci, events, inspection, topology, transfer, tuning

def run_monitor(
    monitor: inspection.Monitor,
    receiver: object,
    callback: Callable[[inspection.MonitorEntry], None] | None,
    duration: float | str | None,
    cancel: events.Cancellation,
    now: Callable[[], int],
    metrics: bool,
) -> inspection.MonitorReport: ...

class DiscoveryPollState:
    def __init__(
        self, protocol: str, port_limit: int, detail_limit: int, history_limit: int
    ) -> None: ...
    def poll(self, ports: Callable[[str], object]) -> topology.Report: ...
    def snapshot(self) -> topology.Report: ...
    @property
    def closed(self) -> bool: ...
    def close(self) -> None: ...

def run_ci(
    browser: ci.Browser,
    receiver: object,
    output: object,
    cancel: events.Cancellation,
    now: Callable[[], int],
    message_limit: int,
    byte_limit: int,
) -> ci.BrowseReport: ...
def run_transfer_input(
    capture: transfer.Capture,
    receiver: object,
    cancel: events.Cancellation,
    now: Callable[[], int],
) -> transfer.CaptureReport: ...
def run_tuning(
    query: tuning.Query,
    receiver: object,
    output: object,
    cancel: events.Cancellation,
    now: Callable[[], int],
) -> tuning.QueryReport: ...
def run_transfer_output(
    session: transfer.Session,
    output: object,
    cancel: events.Cancellation,
    now: Callable[[], int],
) -> transfer.Report: ...

"""Pure universal values backed by the shared Rust toolkit."""

from . import messages

class IdentityRequest(messages.Message):
    def __init__(self, *, device_id: int) -> None: ...
    @property
    def device_id(self) -> int: ...
    def replace(self, *, device_id: int = ...) -> IdentityRequest: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...

class IdentityReply(messages.Message):
    def __init__(
        self,
        *,
        device_id: int,
        manufacturer: list[int] | tuple[int, ...],
        family: int,
        model: int,
        revision: list[int] | tuple[int, ...],
    ) -> None: ...
    @property
    def device_id(self) -> int: ...
    @property
    def manufacturer(self) -> tuple[int, ...]: ...
    @property
    def family(self) -> int: ...
    @property
    def model(self) -> int: ...
    @property
    def revision(self) -> tuple[int, ...]: ...
    def replace(
        self,
        *,
        device_id: int = ...,
        manufacturer: list[int] | tuple[int, ...] = ...,
        family: int = ...,
        model: int = ...,
        revision: list[int] | tuple[int, ...] = ...,
    ) -> IdentityReply: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...

class MasterVolume(messages.Message):
    def __init__(self, *, device_id: int, value: int) -> None: ...
    @property
    def device_id(self) -> int: ...
    @property
    def value(self) -> int: ...
    def replace(self, *, device_id: int = ..., value: int = ...) -> MasterVolume: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...

class MasterFineTuning(messages.Message):
    def __init__(self, *, device_id: int, value: int) -> None: ...
    @property
    def device_id(self) -> int: ...
    @property
    def value(self) -> int: ...
    def replace(
        self, *, device_id: int = ..., value: int = ...
    ) -> MasterFineTuning: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...

class MasterCoarseTuning(messages.Message):
    def __init__(self, *, device_id: int, semitones: int) -> None: ...
    @property
    def device_id(self) -> int: ...
    @property
    def semitones(self) -> int: ...
    def replace(
        self, *, device_id: int = ..., semitones: int = ...
    ) -> MasterCoarseTuning: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...

def decode(
    message: messages.SysEx,
) -> (
    IdentityRequest
    | IdentityReply
    | MasterVolume
    | MasterFineTuning
    | MasterCoarseTuning
    | None
): ...

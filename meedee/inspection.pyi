"""Streaming file inspection. Counts cover the verified prefix on failure."""

from collections.abc import Callable
from os import PathLike
from typing import BinaryIO, Literal

from . import archive, events, messages, metrics, midi, notes, smf

def run(
    monitor: Monitor,
    receiver: midi.Input,
    *,
    callback: Callable[[MonitorEntry], None] | None = None,
    duration: float | str | None = None,
    cancel: events.Cancellation | None = None,
    metrics: bool = False,
) -> MonitorReport: ...

class Monitor:
    def __init__(
        self,
        *,
        stream: str,
        clock: events.Clock,
        protocol: Literal["midi1", "ump"] = "midi1",
        types: list[str] = [],
        channel: int | None = None,
        group: int | None = None,
        detail_limit: int = 128,
    ) -> None: ...
    def feed(
        self, item: messages.Message | events.StreamDiagnostic
    ) -> MonitorEntry | None: ...
    def counter(self, total: int) -> MonitorEntry | None: ...
    def snapshot(self) -> MonitorReport: ...

class MonitorEntry:
    @property
    def kind(self) -> Literal["event", "diagnostic", "loss_counter"]: ...
    @property
    def message(self) -> messages.Message | None: ...
    @property
    def diagnostic(self) -> events.StreamDiagnostic | None: ...
    @property
    def transport_drop_total(self) -> int | None: ...
    @property
    def observations(self) -> list[events.Observation]: ...
    @property
    def note_state(self) -> list[notes.ChannelState]: ...

class MonitorReport:
    @property
    def inspection(self) -> Report: ...
    @property
    def filtered(self) -> int: ...
    @property
    def diagnostics(self) -> int: ...
    @property
    def transport_drops(self) -> int: ...
    @property
    def interrupted(self) -> bool: ...
    @property
    def delivery(self) -> metrics.DeliveryReport | None: ...

def inspect_file(
    source: str | PathLike[str] | BinaryIO,
    *,
    format: Literal["archive", "smf", "syx", "clip"],
    payload_limit: int | str = 1_048_576,
    preserve_unknown: bool = False,
    detail_limit: int = 128,
) -> Report: ...

class Report:
    @property
    def note_state(self) -> notes.Report: ...
    @property
    def source_counts(self) -> dict[str, int]: ...
    @property
    def timing_segments(self) -> list[TimingSegment]: ...
    @property
    def timing_diagnostics(self) -> list[TimingDiagnostic]: ...
    @property
    def timestamp_regressions(self) -> int: ...
    @property
    def omitted_segments(self) -> int: ...
    @property
    def omitted_diagnostics(self) -> int: ...
    @property
    def complete(self) -> bool: ...
    @property
    def problem(self) -> str | None: ...
    @property
    def records(self) -> int: ...
    @property
    def message_counts(self) -> dict[str, int]: ...
    @property
    def clocks(self) -> list[events.Clock]: ...
    @property
    def streams(self) -> list[archive.Stream]: ...
    @property
    def smf_header(self) -> smf.Header | None: ...
    @property
    def track_records(self) -> dict[int, int]: ...
    @property
    def gap_records(self) -> int: ...
    @property
    def lost_events(self) -> int: ...
    @property
    def discontinuities(self) -> int: ...
    @property
    def untimed_events(self) -> int: ...
    @property
    def opaque_records(self) -> int: ...

class TimingSegment:
    @property
    def source(self) -> str: ...
    @property
    def clock_identity(self) -> str | None: ...
    @property
    def number(self) -> int: ...
    @property
    def events(self) -> int: ...
    @property
    def untimed(self) -> int: ...
    @property
    def first(self) -> int | None: ...
    @property
    def last(self) -> int | None: ...
    @property
    def minimum(self) -> int | None: ...
    @property
    def maximum(self) -> int | None: ...
    @property
    def regressions(self) -> int: ...

class TimingDiagnostic:
    @property
    def source(self) -> str: ...
    @property
    def record(self) -> int: ...
    @property
    def kind(self) -> str: ...

def compare_files(
    left: str | PathLike[str] | BinaryIO,
    right: str | PathLike[str] | BinaryIO,
    *,
    format: Literal["archive", "smf", "syx", "clip"],
    source_map: dict[str, str] | None = None,
    clock_map: dict[str, str] | None = None,
    ignore_timestamps: bool = False,
    tick_tolerance: int = 0,
    payload_limit: int | str = 1_048_576,
    detail_limit: int = 128,
    preserve_unknown: bool = False,
) -> ComparisonReport: ...

class ComparisonReport:
    @property
    def equal(self) -> bool: ...
    @property
    def left_complete(self) -> bool: ...
    @property
    def right_complete(self) -> bool: ...
    @property
    def left_problem(self) -> str | None: ...
    @property
    def right_problem(self) -> str | None: ...
    @property
    def left_records(self) -> int: ...
    @property
    def right_records(self) -> int: ...
    @property
    def differences(self) -> int: ...
    @property
    def examples(self) -> list[Difference]: ...

class Difference:
    @property
    def record(self) -> int | None: ...
    @property
    def reason(self) -> str: ...

class Observer:
    def channel_states(
        self, *, channel: int, group: int | None = None
    ) -> list[notes.ChannelState]: ...
    def __init__(
        self, *, stream: str, clock: events.Clock, detail_limit: int = 128
    ) -> None: ...
    def feed(self, item: messages.Message | events.StreamDiagnostic) -> None: ...
    def loss_counter_changed(self) -> None: ...
    def snapshot(self) -> Report: ...

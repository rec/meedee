"""meedee archive v1. Normal reading verifies completion; recovery is explicit."""

from collections.abc import Iterator
from os import PathLike
from typing import BinaryIO

from . import events

class Stream:
    def __init__(self, *, id: str, label: str) -> None: ...
    @property
    def id(self) -> str: ...
    @property
    def label(self) -> str: ...
    def replace(self, **changes: object) -> Stream: ...

class Gap:
    def __init__(self, *, stream: str, lost: int, reason: str) -> None: ...
    @property
    def stream(self) -> str: ...
    @property
    def lost(self) -> int: ...
    @property
    def reason(self) -> str: ...
    def replace(self, **changes: object) -> Gap: ...

class Discontinuity:
    def __init__(self, *, stream: str, reason: str) -> None: ...
    @property
    def stream(self) -> str: ...
    @property
    def reason(self) -> str: ...
    def replace(self, **changes: object) -> Discontinuity: ...

class Metadata:
    def __init__(self, *, key: str, data: bytes | bytearray | memoryview) -> None: ...
    @property
    def key(self) -> str: ...
    @property
    def data(self) -> bytes: ...
    def replace(self, **changes: object) -> Metadata: ...

class Opaque:
    def __init__(self, *, kind: int, data: bytes | bytearray | memoryview) -> None: ...
    @property
    def kind(self) -> int: ...
    @property
    def data(self) -> bytes: ...
    def replace(self, **changes: object) -> Opaque: ...

class Reader:
    def __init__(
        self,
        source: str | PathLike[str] | BinaryIO,
        *,
        payload_limit: int = 1_048_576,
        recover: bool = False,
        preserve_unknown: bool = False,
    ) -> None: ...
    def __iter__(
        self,
    ) -> Iterator[
        events.Clock | Stream | events.Event | Gap | Metadata | Discontinuity | Opaque
    ]: ...
    def __next__(
        self,
    ) -> (
        events.Clock | Stream | events.Event | Gap | Metadata | Discontinuity | Opaque
    ): ...
    @property
    def complete(self) -> bool: ...
    @property
    def problem(self) -> str | None: ...

class Writer:
    def __init__(
        self,
        destination: str | PathLike[str] | BinaryIO,
        *,
        payload_limit: int = 1_048_576,
    ) -> None: ...
    def write(
        self,
        record: events.Clock
        | Stream
        | events.Event
        | Gap
        | Metadata
        | Discontinuity
        | Opaque,
    ) -> None: ...
    def finish(self, *, complete: bool = True, reason: str = "") -> None: ...

"""meedee archive v1. Normal reading verifies completion; recovery is explicit."""

from collections.abc import Iterator
from os import PathLike
from typing import BinaryIO

from . import events, metrics

class Stream:
    def __init__(
        self, *, id: str, label: str, clock_identity: str | None = None
    ) -> None: ...
    @property
    def id(self) -> str: ...
    @property
    def label(self) -> str: ...
    @property
    def clock_identity(self) -> str | None: ...
    def replace(self, **changes: object) -> Stream: ...

class Gap:
    def __init__(self, *, stream: str, lost: int, reason: str) -> None: ...
    @property
    def stream(self) -> str: ...
    @property
    def lost(self) -> int: ...
    @property
    def reason(self) -> str: ...
    def replace(self, **changes: object) -> Gap: ...

class Discontinuity:
    def __init__(self, *, stream: str, reason: str) -> None: ...
    @property
    def stream(self) -> str: ...
    @property
    def reason(self) -> str: ...
    def replace(self, **changes: object) -> Discontinuity: ...

class Metadata:
    def __init__(
        self,
        *,
        key: str,
        data: bytes | bytearray | memoryview,
        stream: str | None = None,
        timestamp: events.Timestamp | None = None,
    ) -> None: ...
    @property
    def key(self) -> str: ...
    @property
    def data(self) -> bytes: ...
    @property
    def stream(self) -> str | None: ...
    @property
    def timestamp(self) -> events.Timestamp | None: ...
    def replace(self, **changes: object) -> Metadata: ...

class Opaque:
    def __init__(self, *, kind: int, data: bytes | bytearray | memoryview) -> None: ...
    @property
    def kind(self) -> int: ...
    @property
    def data(self) -> bytes: ...
    def replace(self, **changes: object) -> Opaque: ...

class Reader:
    def __init__(
        self,
        source: str | PathLike[str] | BinaryIO,
        *,
        payload_limit: int = 1_048_576,
        recover: bool = False,
        preserve_unknown: bool = False,
    ) -> None: ...
    def close(self) -> None: ...
    def __iter__(
        self,
    ) -> Iterator[
        events.Clock | Stream | events.Event | Gap | Metadata | Discontinuity | Opaque
    ]: ...
    def __next__(
        self,
    ) -> (
        events.Clock | Stream | events.Event | Gap | Metadata | Discontinuity | Opaque
    ): ...
    @property
    def complete(self) -> bool: ...
    @property
    def problem(self) -> str | None: ...

class Writer:
    def __init__(
        self,
        destination: str | PathLike[str] | BinaryIO,
        *,
        payload_limit: int = 1_048_576,
    ) -> None: ...
    def write(
        self,
        record: events.Clock
        | Stream
        | events.Event
        | Gap
        | Metadata
        | Discontinuity
        | Opaque,
    ) -> None: ...
    def finish(self, *, complete: bool = True, reason: str = "") -> None: ...

class RecordingReport:
    @property
    def pressure(self) -> metrics.Pressure | None: ...
    @property
    def complete(self) -> bool: ...
    @property
    def records(self) -> int: ...
    @property
    def gap_records(self) -> int: ...
    @property
    def failure(self) -> str | None: ...

class Recorder:
    @property
    def pressure(self) -> metrics.Pressure | None: ...
    def __init__(
        self,
        destination: str | PathLike[str],
        *,
        clock: events.Clock,
        stream: str,
        label: str = "",
        best_effort: bool = False,
        payload_limit: int = 1_048_576,
        record_limit: int = 128,
        byte_limit: int = 8_388_608,
        metrics: bool = False,
    ) -> None: ...
    def record(
        self,
        record: events.Event | events.StreamDiagnostic | Gap | Discontinuity | Metadata,
    ) -> bool: ...
    def fail(self, reason: str) -> None: ...
    @property
    def failure(self) -> str | None: ...
    def stop(self, *, timeout: float = 5.0) -> RecordingReport: ...

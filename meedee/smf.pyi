"""Streaming Standard MIDI Files; division is the exact 16-bit file field."""

from collections.abc import Iterator
from os import PathLike
from typing import BinaryIO

from . import events, messages, translation
from .events import Rational

class Header:
    def __init__(
        self,
        *,
        format: int,
        tracks: int,
        division: int,
        extra: bytes | bytearray | memoryview | None = None,
    ) -> None: ...
    @property
    def format(self) -> int: ...
    @property
    def tracks(self) -> int: ...
    @property
    def division(self) -> int: ...
    @property
    def extra(self) -> bytes: ...
    def replace(self, **changes: object) -> Header: ...

class Meta:
    def __init__(self, *, kind: int, data: bytes | bytearray | memoryview) -> None: ...
    @property
    def kind(self) -> int: ...
    @property
    def data(self) -> bytes: ...
    def replace(self, **changes: object) -> Meta: ...

class SysExFragment:
    def __init__(
        self, *, status: int, data: bytes | bytearray | memoryview
    ) -> None: ...
    @property
    def status(self) -> int: ...
    @property
    def data(self) -> bytes: ...
    def replace(self, **changes: object) -> SysExFragment: ...

class UnknownChunk:
    def __init__(self, *, id: bytes, data: bytes | bytearray | memoryview) -> None: ...
    @property
    def id(self) -> bytes: ...
    @property
    def data(self) -> bytes: ...
    def replace(self, **changes: object) -> UnknownChunk: ...

class Event:
    def __init__(
        self,
        *,
        track: int,
        tick: int | str,
        record: messages.Message | Meta | SysExFragment | UnknownChunk,
    ) -> None: ...
    @property
    def track(self) -> int: ...
    @property
    def tick(self) -> int: ...
    @property
    def record(self) -> messages.Message | Meta | SysExFragment | UnknownChunk: ...
    @property
    def channel(self) -> int | None: ...
    def transpose(self, semitones: int) -> Event: ...
    def replace(self, **changes: object) -> Event: ...

class Reader:
    def __init__(
        self,
        source: str | PathLike[str] | BinaryIO,
        *,
        payload_limit: int | str = 1_048_576,
    ) -> None: ...
    @property
    def header(self) -> Header: ...
    def __iter__(self) -> Iterator[Event]: ...
    def __next__(self) -> Event: ...
    def close(self) -> None: ...

class Writer:
    def __init__(
        self,
        destination: str | PathLike[str] | BinaryIO,
        *,
        header: Header,
        payload_limit: int | str = 1_048_576,
    ) -> None: ...
    def write(self, event: Event) -> None: ...
    def finish(self) -> None: ...

class MergedReader:
    def __init__(
        self,
        source: str | PathLike[str] | BinaryIO,
        *,
        sequence: int | None = None,
        payload_limit: int | str = 1_048_576,
        track_limit: int = 128,
        buffer_limit: int | str = 8_388_608,
    ) -> None: ...
    @property
    def header(self) -> Header: ...
    def __iter__(self) -> Iterator[Event]: ...
    def __next__(self) -> Event: ...
    def close(self) -> None: ...

class TimedReader:
    def __init__(
        self,
        source: str | PathLike[str] | BinaryIO,
        *,
        stream: str,
        sequence: int | None = None,
        payload_limit: int | str = 1_048_576,
        track_limit: int = 128,
        buffer_limit: int | str = 8_388_608,
    ) -> None: ...
    @property
    def header(self) -> Header: ...
    @property
    def clock(self) -> events.Clock: ...
    @property
    def origin(self) -> events.Timestamp: ...
    def __iter__(self) -> Iterator[messages.Message | events.StreamDiagnostic]: ...
    def __next__(self) -> messages.Message | events.StreamDiagnostic: ...
    def close(self) -> None: ...

class ExportReport:
    @property
    def status(self) -> translation.TranslationStatus: ...
    @property
    def reason(self) -> str: ...
    @property
    def rounding_error_ticks(self) -> Rational: ...
    @property
    def events(self) -> list[Event]: ...

def export_event(
    event: messages.Message,
    *,
    header: Header,
    origin: events.Timestamp,
    track: int = 0,
    tempo: float | str = 120.0,
    mapping: events.ClockMapping | None = None,
    allow_loss: bool = False,
) -> ExportReport: ...

class Timeline:
    def __init__(
        self,
        header: Header,
        *,
        stream: str,
        sequence: int | None = None,
        payload_limit: int | str = 1_048_576,
    ) -> None: ...
    @property
    def clock(self) -> events.Clock: ...
    @property
    def origin(self) -> events.Timestamp: ...
    def feed(
        self, event: Event
    ) -> list[messages.Message | events.StreamDiagnostic]: ...
    def finish(self) -> list[messages.Message | events.StreamDiagnostic]: ...

def validate_meta(
    kind: int, data: bytes | bytearray | memoryview, *, offset: int = 0
) -> None: ...

"""Private Python adapter to Rust transport and lifecycle controls."""

from collections.abc import Callable

from . import events, midi

class CallbackBridge:
    def __init__(self, callable: Callable[..., object]) -> None: ...
    def deliver(self, packet: events.ReceivedPacket) -> None: ...
    def deliver_typed(self, packet: events.Event | events.StreamDiagnostic) -> None: ...
    def retire(self) -> None: ...
    def drain(self) -> None: ...
    @property
    def last_message_time(self) -> float | None: ...
    @property
    def discarded_packets(self) -> int: ...

def check_thread() -> None: ...
def prepare_send(protocol: midi.Protocol, packet: object) -> bytes | midi.UmpPacket: ...
def prepare_command(
    protocol: midi.Protocol, command: object
) -> tuple[str, dict[str, int], int]: ...

class MidiError(Exception): ...
class CapabilityError(MidiError): ...
class InitError(MidiError): ...
class PortInfoError(MidiError): ...
class ConnectError(MidiError): ...
class SendError(MidiError): ...
class StateError(RuntimeError): ...
class CallbackThreadError(RuntimeError): ...
class NativePanicError(RuntimeError): ...
class ResourceError(RuntimeError): ...
class WorkerError(RuntimeError): ...
class WorkerTimeoutError(TimeoutError): ...

class Input:
    def __init__(self, **settings: object) -> None: ...
    def ports(self) -> list[midi.Port]: ...
    def connect(
        self,
        port: midi.Port,
        callback: Callable[[events.ReceivedPacket], object],
        clock_identity: str,
    ) -> InputConnection: ...
    def create_virtual(
        self,
        name: str,
        callback: Callable[[events.ReceivedPacket], object],
        clock_identity: str,
    ) -> InputConnection: ...

class Output:
    def __init__(self, **settings: object) -> None: ...
    def ports(self) -> list[midi.Port]: ...
    def connect(self, port: midi.Port) -> OutputConnection: ...
    def create_virtual(self, name: str) -> OutputConnection: ...

class InputConnection:
    @property
    def clock(self) -> events.Clock: ...
    @property
    def dropped_packets(self) -> int: ...
    @property
    def last_message_time(self) -> float | None: ...
    @property
    def closed(self) -> bool: ...
    def close(self) -> None: ...
    def __enter__(self) -> InputConnection: ...

class OutputConnection:
    def send(self, packet: bytes | midi.UmpPacket) -> None: ...
    def send_command(self, command: object) -> None: ...
    @property
    def closed(self) -> bool: ...
    def close(self) -> None: ...
    def __enter__(self) -> OutputConnection: ...

def prepare_message(
    protocol: midi.Protocol, message: object
) -> bytes | midi.UmpPacket: ...
def live_size(item: events.Event | events.StreamDiagnostic) -> int: ...
def play(
    output: object,
    source: object,
    *,
    origin: events.Timestamp,
    mappings: list[events.ClockMapping] | tuple[events.ClockMapping, ...] | None = None,
    cancel: events.Cancellation | None = None,
    allow_rounding: bool = False,
    metrics: bool = False,
) -> events.PlaybackReport: ...

from enum import Enum

from .messages import Message

class TranslationStatus(Enum):
    Exact = ...
    Quantized = ...
    Unsupported = ...
    ProfileDependent = ...
    ContextRequired = ...

class Translation:
    @property
    def status(self) -> TranslationStatus: ...
    @property
    def reason(self) -> str: ...
    @property
    def group(self) -> int | None: ...
    @property
    def converted(self) -> bool: ...
    @property
    def messages(self) -> list[Message]: ...

def to_midi1(message: Message, *, allow_loss: bool = False) -> Translation: ...
def to_midi2(message: Message, *, group: int) -> Translation: ...
def scale_up(*, value: int, source_bits: int, destination_bits: int) -> int: ...

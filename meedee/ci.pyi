"""MIDI-CI 1.2.1 management. Profiles and Property Exchange remain deferred."""

from typing import ClassVar

from .messages import Message, SysEx

BROADCAST_MUID: int
MAX_MUID: int

class Address:
    GROUP: ClassVar[Address]
    FUNCTION_BLOCK: ClassVar[Address]
    @staticmethod
    def channel(*, channel: int) -> Address: ...
    @property
    def channel_number(self) -> int | None: ...

class Header:
    def __init__(
        self,
        *,
        source_muid: int,
        destination_muid: int,
        version: int = 2,
        address: Address | None = None,
    ) -> None: ...
    @property
    def source_muid(self) -> int: ...
    @property
    def destination_muid(self) -> int: ...
    @property
    def version(self) -> int: ...
    @property
    def address(self) -> Address: ...
    def replace(self, **changes: object) -> Header: ...

class Identity:
    def __init__(
        self,
        *,
        manufacturer: bytes | bytearray | memoryview,
        family: int,
        model: int,
        revision: bytes | bytearray | memoryview,
    ) -> None: ...
    @property
    def manufacturer(self) -> bytes: ...
    @property
    def family(self) -> int: ...
    @property
    def model(self) -> int: ...
    @property
    def revision(self) -> bytes: ...
    def replace(self, **changes: object) -> Identity: ...

class DiscoveryInfo:
    def __init__(
        self,
        *,
        identity: Identity,
        capabilities: int,
        max_sysex: int,
        output_path: int | None = None,
    ) -> None: ...
    @property
    def identity(self) -> Identity: ...
    @property
    def capabilities(self) -> int: ...
    @property
    def max_sysex(self) -> int: ...
    @property
    def output_path(self) -> int | None: ...
    def replace(self, **changes: object) -> DiscoveryInfo: ...

class Notice:
    def __init__(
        self,
        *,
        original: int,
        status: int,
        status_data: int,
        details: bytes | bytearray | memoryview,
        message_text: bytes | bytearray | memoryview,
    ) -> None: ...
    @property
    def original(self) -> int: ...
    @property
    def status(self) -> int: ...
    @property
    def status_data(self) -> int: ...
    @property
    def details(self) -> bytes: ...
    @property
    def message_text(self) -> bytes: ...
    def replace(self, **changes: object) -> Notice: ...

class Discovery(Message):
    def __init__(
        self,
        *,
        header: Header,
        info: DiscoveryInfo,
        extensions: bytes | bytearray | memoryview | None = None,
    ) -> None: ...
    @property
    def header(self) -> Header: ...
    @property
    def info(self) -> DiscoveryInfo: ...
    @property
    def extensions(self) -> bytes: ...
    def replace(self, **changes: object) -> Discovery: ...

class DiscoveryReply(Message):
    def __init__(
        self,
        *,
        header: Header,
        info: DiscoveryInfo,
        function_block: int | None = None,
        extensions: bytes | bytearray | memoryview | None = None,
    ) -> None: ...
    @property
    def header(self) -> Header: ...
    @property
    def info(self) -> DiscoveryInfo: ...
    @property
    def function_block(self) -> int | None: ...
    @property
    def extensions(self) -> bytes: ...
    def replace(self, **changes: object) -> DiscoveryReply: ...

class EndpointInquiry(Message):
    def __init__(
        self,
        *,
        header: Header,
        extensions: bytes | bytearray | memoryview | None = None,
    ) -> None: ...
    @property
    def header(self) -> Header: ...
    @property
    def extensions(self) -> bytes: ...
    def replace(self, **changes: object) -> EndpointInquiry: ...

class EndpointReply(Message):
    def __init__(
        self,
        *,
        header: Header,
        product_instance_id: str,
        extensions: bytes | bytearray | memoryview | None = None,
    ) -> None: ...
    @property
    def header(self) -> Header: ...
    @property
    def product_instance_id(self) -> str: ...
    @property
    def extensions(self) -> bytes: ...
    def replace(self, **changes: object) -> EndpointReply: ...

class InvalidateMuid(Message):
    def __init__(
        self,
        *,
        header: Header,
        target: int,
        extensions: bytes | bytearray | memoryview | None = None,
    ) -> None: ...
    @property
    def header(self) -> Header: ...
    @property
    def target(self) -> int: ...
    @property
    def extensions(self) -> bytes: ...
    def replace(self, **changes: object) -> InvalidateMuid: ...

class Ack(Message):
    def __init__(
        self,
        *,
        header: Header,
        notice: Notice,
        extensions: bytes | bytearray | memoryview | None = None,
    ) -> None: ...
    @property
    def header(self) -> Header: ...
    @property
    def notice(self) -> Notice: ...
    @property
    def extensions(self) -> bytes: ...
    def replace(self, **changes: object) -> Ack: ...

class Nak(Message):
    def __init__(
        self,
        *,
        header: Header,
        notice: Notice | None = None,
        extensions: bytes | bytearray | memoryview | None = None,
    ) -> None: ...
    @property
    def header(self) -> Header: ...
    @property
    def notice(self) -> Notice | None: ...
    @property
    def extensions(self) -> bytes: ...
    def replace(self, **changes: object) -> Nak: ...

class Route:
    def __init__(
        self, *, input: str, output: str, group: int | None = None
    ) -> None: ...
    @property
    def input(self) -> str: ...
    @property
    def output(self) -> str: ...
    @property
    def group(self) -> int | None: ...
    def replace(self, **changes: object) -> Route: ...

class Peer:
    @property
    def muid(self) -> int: ...
    @property
    def version(self) -> int: ...
    @property
    def info(self) -> DiscoveryInfo: ...
    @property
    def function_block(self) -> int | None: ...
    @property
    def product_instance_id(self) -> str | None: ...

class Action:
    @property
    def token(self) -> int: ...
    @property
    def route(self) -> Route: ...
    @property
    def message(self) -> Message: ...

class Observation:
    @property
    def kind(self) -> str: ...
    @property
    def peer_muid(self) -> int | None: ...
    @property
    def token(self) -> int | None: ...
    @property
    def message(self) -> Message | None: ...
    @property
    def reason(self) -> str: ...

class Session:
    def __init__(
        self,
        *,
        local_muid: int,
        identity: Identity,
        route: Route,
        output_path: int = 0,
        function_block: int | None = None,
        max_sysex: int = 1_048_576,
        peer_limit: int = 16,
        exchange_limit: int = 16,
        reply_byte_limit: int = 8_388_608,
    ) -> None: ...
    @property
    def local_muid(self) -> int: ...
    @property
    def active(self) -> bool: ...
    @property
    def route(self) -> Route: ...
    @property
    def peers(self) -> list[Peer]: ...
    @property
    def pending_count(self) -> int: ...
    def discover(self, *, now_ns: int, timeout_ns: int = 3_000_000_000) -> Action: ...
    def inquire_endpoint(
        self, *, peer_muid: int, now_ns: int, timeout_ns: int
    ) -> Action: ...
    def report_send(
        self, *, token: int, sent: bool, now_ns: int
    ) -> list[Action | Observation]: ...
    def feed(
        self, message: Message, *, input: str, group: int | None = None, now_ns: int
    ) -> list[Action | Observation]: ...
    def poll(self, *, now_ns: int) -> list[Action | Observation]: ...
    def reset(self, *, reason: str) -> list[Action | Observation]: ...
    def restart(self, *, local_muid: int, now_ns: int) -> None: ...
    def respond(self, message: Message, *, now_ns: int, timeout_ns: int) -> Action: ...

def decode(
    message: SysEx,
) -> (
    Discovery
    | DiscoveryReply
    | EndpointInquiry
    | EndpointReply
    | InvalidateMuid
    | Ack
    | Nak
    | None
): ...

class Browser:
    @property
    def route(self) -> Route: ...
    def __init__(
        self,
        *,
        local_muid: int,
        identity: Identity,
        route: Route,
        output_path: int = 0,
        function_block: int | None = None,
        max_sysex: int = 1_048_576,
        peer_limit: int = 16,
        exchange_limit: int = 16,
        reply_byte_limit: int = 8_388_608,
        discovery_ns: int = 3_000_000_000,
        endpoint_ns: int = 1_000_000_000,
        timeout_ns: int = 30_000_000_000,
        detail_limit: int = 128,
    ) -> None: ...
    def start(self, now_ns: int) -> list[Action]: ...
    def poll(self, now_ns: int) -> list[Action]: ...
    def feed(
        self, message: Message, *, input: str, group: int | None = None, now_ns: int
    ) -> list[Action]: ...
    def report_send(self, *, token: int, sent: bool, now_ns: int) -> list[Action]: ...
    def stop(self, reason: str) -> None: ...
    def snapshot(self) -> BrowseReport: ...

class BrowseReport:
    @property
    def status(self) -> str: ...
    @property
    def local_muid(self) -> int: ...
    @property
    def peers(self) -> list[Peer]: ...
    @property
    def confirmed_actions(self) -> int: ...
    @property
    def uncertain_token(self) -> int | None: ...
    @property
    def pending_tokens(self) -> list[int]: ...
    @property
    def diagnostics(self) -> list[BrowseDiagnostic]: ...
    @property
    def omitted_diagnostics(self) -> int: ...
    @property
    def problems(self) -> int: ...
    @property
    def reason(self) -> str | None: ...

class BrowseDiagnostic:
    @property
    def kind(self) -> str: ...
    @property
    def peer_muid(self) -> int | None: ...
    @property
    def token(self) -> int | None: ...
    @property
    def reason(self) -> str: ...

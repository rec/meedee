"""Immutable values backed by the shared Rust MIDI toolkit."""

class Message:
    """Abstract native base. Direct construction is rejected."""

class NoteOn(Message):
    def __init__(
        self, note: int, velocity: int = 90, channel: int | None = None
    ) -> None: ...
    @property
    def channel(self) -> int | None: ...
    @property
    def note(self) -> int: ...
    @property
    def velocity(self) -> int: ...
    def replace(
        self, *, channel: int | None = ..., note: int = ..., velocity: int = ...
    ) -> NoteOn: ...

class SysEx(Message):
    def __init__(self, data: bytes | bytearray | memoryview) -> None: ...
    @property
    def data(self) -> bytes: ...
    def replace(self, data: bytes | bytearray | memoryview = ...) -> SysEx: ...


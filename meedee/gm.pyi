GM1_DRUM_CHANNEL: int
GM2_ON_SETTLING_NS: int

def programs() -> list[Program]: ...
def program(*, program: int) -> Program: ...
def gm2_programs() -> list[BankProgram]: ...
def gm2_program(*, bank_lsb: int, program: int) -> BankProgram | None: ...
def find_programs(name: str) -> list[Program | BankProgram]: ...
def drum_kits() -> list[DrumKit]: ...
def find_drum_kits(name: str) -> list[DrumKit]: ...
def percussion(*, note: int) -> Percussion | None: ...
def gm2_percussion(*, program: int, note: int) -> Percussion | None: ...
def decode(
    message: messages.SysEx, *, max_entries: int = 1024
) -> (
    Gm1On
    | GmOff
    | Gm2On
    | ControllerDestination
    | KeyBasedControl
    | GlobalParameterControl
    | None
): ...

class ControllerDestination(messages.Message):
    def __init__(
        self,
        *,
        device_id: int,
        channel: int,
        source: int,
        controller: int | None,
        entries: list[tuple[int, int]] | tuple[tuple[int, int], ...],
        max_entries: int = 1024,
    ) -> None: ...
    @property
    def device_id(self) -> int: ...
    @property
    def channel(self) -> int: ...
    @property
    def source(self) -> int: ...
    @property
    def controller(self) -> int | None: ...
    @property
    def entries(self) -> tuple[tuple[int, int], ...]: ...
    @property
    def max_entries(self) -> int: ...
    def replace(self, **changes: object) -> ControllerDestination: ...

class KeyBasedControl(messages.Message):
    def __init__(
        self,
        *,
        device_id: int,
        channel: int,
        note: int,
        entries: list[tuple[int, int]] | tuple[tuple[int, int], ...],
        max_entries: int = 1024,
    ) -> None: ...
    @property
    def device_id(self) -> int: ...
    @property
    def channel(self) -> int: ...
    @property
    def note(self) -> int: ...
    @property
    def entries(self) -> tuple[tuple[int, int], ...]: ...
    @property
    def max_entries(self) -> int: ...
    def replace(self, **changes: object) -> KeyBasedControl: ...

class GlobalParameterControl(messages.Message):
    def __init__(
        self,
        *,
        device_id: int,
        slot_path: list[int] | tuple[int, ...],
        parameter_width: int,
        value_width: int,
        entries: list[tuple[tuple[int, ...], tuple[int, ...]]]
        | tuple[tuple[tuple[int, ...], tuple[int, ...]], ...],
        max_entries: int = 1024,
    ) -> None: ...
    @property
    def device_id(self) -> int: ...
    @property
    def slot_path(self) -> tuple[int, ...]: ...
    @property
    def parameter_width(self) -> int: ...
    @property
    def value_width(self) -> int: ...
    @property
    def entries(self) -> tuple[tuple[tuple[int, ...], tuple[int, ...]], ...]: ...
    @property
    def max_entries(self) -> int: ...
    def replace(self, **changes: object) -> GlobalParameterControl: ...

def reverb_parameter(
    *, device_id: int, parameter: int, value: int
) -> GlobalParameterControl: ...
def chorus_parameter(
    *, device_id: int, parameter: int, value: int
) -> GlobalParameterControl: ...

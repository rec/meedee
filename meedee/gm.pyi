"""Pure gm values backed by the shared Rust toolkit."""

from . import messages

class BankProgramSelect(messages.Message):
    def __init__(
        self, *, channel: int, bank_msb: int, bank_lsb: int, program: int
    ) -> None: ...
    @property
    def channel(self) -> int: ...
    @property
    def bank_msb(self) -> int: ...
    @property
    def bank_lsb(self) -> int: ...
    @property
    def program(self) -> int: ...
    def replace(
        self,
        *,
        channel: int = ...,
        bank_msb: int = ...,
        bank_lsb: int = ...,
        program: int = ...,
    ) -> BankProgramSelect: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...

class Gm1On(messages.Message):
    def __init__(self, *, device_id: int) -> None: ...
    @property
    def device_id(self) -> int: ...
    def replace(self, *, device_id: int = ...) -> Gm1On: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...


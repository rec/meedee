"""Pure gm values backed by the shared Rust toolkit."""

from typing import Literal, overload

from . import events, messages

class GmMode(messages.Message):
    def __init__(
        self, mode: Literal["gm1", "gm2", "off"], *, device_id: int
    ) -> None: ...
    @property
    def mode(self) -> Literal["gm1", "gm2", "off"]: ...
    @property
    def device_id(self) -> int: ...
    def replace(
        self,
        *,
        mode: Literal["gm1", "gm2", "off"] = ...,
        device_id: int = ...,
        timestamp: events.Timestamp | None = ...,
        stream: str | None = ...,
        span: events.SourceSpan | None = ...,
    ) -> GmMode: ...

class Program:
    @property
    def bank_msb(self) -> int | None: ...
    @property
    def bank_lsb(self) -> int | None: ...
    @property
    def program(self) -> int: ...
    @property
    def name(self) -> str: ...
    @property
    def family(self) -> str: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...

class DrumKit:
    @property
    def program(self) -> int: ...
    @property
    def bank_msb(self) -> int: ...
    @property
    def bank_lsb(self) -> int: ...
    @property
    def name(self) -> str: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...

class Percussion:
    @property
    def note(self) -> int: ...
    @property
    def name(self) -> str: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...

GM1_DRUM_CHANNEL: int
GM2_ON_SETTLING_NS: int

def programs(*, version: Literal[1, 2] = 1) -> list[Program]: ...
@overload
def program(*, program: int, bank_lsb: None = None) -> Program: ...
@overload
def program(*, program: int, bank_lsb: int) -> Program | None: ...
def find_programs(name: str) -> list[Program]: ...
def drum_kits() -> list[DrumKit]: ...
def find_drum_kits(name: str) -> list[DrumKit]: ...
def percussion(*, note: int, program: int | None = None) -> Percussion | None: ...
def decode(
    message: messages.SysEx, *, max_entries: int = 1024
) -> (
    GmMode | ControllerDestination | KeyBasedControl | GlobalParameterControl | None
): ...

class ControllerDestination(messages.Message):
    def __init__(
        self,
        *,
        device_id: int,
        channel: int,
        source: int,
        controller: int | None,
        entries: list[tuple[int, int]] | tuple[tuple[int, int], ...],
        max_entries: int = 1024,
    ) -> None: ...
    @property
    def device_id(self) -> int: ...
    @property
    def channel(self) -> int | None: ...
    @property
    def source(self) -> int: ...
    @property
    def controller(self) -> int | None: ...
    @property
    def entries(self) -> tuple[tuple[int, int], ...]: ...
    @property
    def max_entries(self) -> int: ...
    def replace(self, **changes: object) -> ControllerDestination: ...

class KeyBasedControl(messages.Message):
    def __init__(
        self,
        *,
        device_id: int,
        channel: int,
        note: int,
        entries: list[tuple[int, int]] | tuple[tuple[int, int], ...],
        max_entries: int = 1024,
    ) -> None: ...
    @property
    def device_id(self) -> int: ...
    @property
    def channel(self) -> int | None: ...
    @property
    def note(self) -> int: ...
    @property
    def entries(self) -> tuple[tuple[int, int], ...]: ...
    @property
    def max_entries(self) -> int: ...
    def replace(self, **changes: object) -> KeyBasedControl: ...

class GlobalParameterControl(messages.Message):
    def __init__(
        self,
        *,
        device_id: int,
        slot_path: list[int] | tuple[int, ...],
        parameter_width: int,
        value_width: int,
        entries: list[tuple[tuple[int, ...], tuple[int, ...]]]
        | tuple[tuple[tuple[int, ...], tuple[int, ...]], ...],
        max_entries: int = 1024,
    ) -> None: ...
    @property
    def device_id(self) -> int: ...
    @property
    def slot_path(self) -> tuple[int, ...]: ...
    @property
    def parameter_width(self) -> int: ...
    @property
    def value_width(self) -> int: ...
    @property
    def entries(self) -> tuple[tuple[tuple[int, ...], tuple[int, ...]], ...]: ...
    @property
    def max_entries(self) -> int: ...
    def replace(self, **changes: object) -> GlobalParameterControl: ...

def reverb_parameter(
    *, device_id: int, parameter: int, value: int
) -> GlobalParameterControl: ...
def chorus_parameter(
    *, device_id: int, parameter: int, value: int
) -> GlobalParameterControl: ...

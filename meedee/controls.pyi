"""Per-source, indexed control observations without transport or timestamps."""

from enum import Enum

from . import messages
from .messages import Message

class Interpreter:
    def __init__(self) -> None: ...
    def feed(
        self, message: Message
    ) -> list[
        ControlObservation | ParameterObservation | ParameterStep | Diagnostic
    ]: ...
    def reset(
        self,
    ) -> list[
        ControlObservation | ParameterObservation | ParameterStep | Diagnostic
    ]: ...

class ControlObservation:
    @property
    def channel(self) -> int: ...
    @property
    def controller(self) -> int: ...
    @property
    def value(self) -> int: ...
    @property
    def resolution(self) -> int: ...
    @property
    def first_index(self) -> int: ...
    @property
    def last_index(self) -> int: ...

class ParameterObservation:
    @property
    def channel(self) -> int: ...
    @property
    def family(self) -> ParameterFamily: ...
    @property
    def parameter(self) -> int: ...
    @property
    def value(self) -> int: ...
    @property
    def resolution(self) -> int: ...
    @property
    def first_index(self) -> int: ...
    @property
    def last_index(self) -> int: ...

class ParameterStep:
    @property
    def channel(self) -> int: ...
    @property
    def family(self) -> ParameterFamily: ...
    @property
    def parameter(self) -> int: ...
    @property
    def direction(self) -> StepDirection: ...
    @property
    def first_index(self) -> int: ...
    @property
    def last_index(self) -> int: ...

class Diagnostic:
    @property
    def kind(self) -> DiagnosticKind: ...
    @property
    def channel(self) -> int | None: ...
    @property
    def controller(self) -> int | None: ...
    @property
    def first_index(self) -> int: ...
    @property
    def last_index(self) -> int: ...

class ParameterFamily(Enum):
    Rpn = ...
    Nrpn = ...

class StepDirection(Enum):
    Increment = ...
    Decrement = ...

class DiagnosticKind(Enum):
    MissingCoarse = ...
    MissingSelection = ...
    IncompleteSelection = ...
    SelectionInvalidated = ...
    StateReset = ...

class Controller(Enum):
    BankSelectMsb = ...
    Modulation = ...
    Breath = ...
    Foot = ...
    PortamentoTime = ...
    DataEntryMsb = ...
    ChannelVolume = ...
    Balance = ...
    Pan = ...
    Expression = ...
    EffectControl1 = ...
    EffectControl2 = ...
    BankSelectLsb = ...
    DataEntryLsb = ...
    Hold1 = ...
    Portamento = ...
    Sostenuto = ...
    SoftPedal = ...
    LegatoFootswitch = ...
    Hold2 = ...
    SoundVariation = ...
    FilterResonance = ...
    ReleaseTime = ...
    AttackTime = ...
    Brightness = ...
    DecayTime = ...
    VibratoRate = ...
    VibratoDepth = ...
    VibratoDelay = ...
    PortamentoControl = ...
    ReverbSend = ...
    ChorusSend = ...
    DataIncrement = ...
    DataDecrement = ...
    NrpnLsb = ...
    NrpnMsb = ...
    RpnLsb = ...
    RpnMsb = ...
    AllSoundOff = ...
    ResetAllControllers = ...
    LocalControl = ...
    AllNotesOff = ...
    OmniOff = ...
    OmniOn = ...
    MonoMode = ...
    PolyMode = ...
    @property
    def number(self) -> int: ...
    def message(self, *, channel: int, value: int) -> messages.ControlChange: ...

def pitch_bend_sensitivity(
    *, channel: int, semitones: int, cents: int
) -> messages.RpnSet: ...
def channel_fine_tuning(*, channel: int, value: int) -> messages.RpnSet: ...
def channel_coarse_tuning(*, channel: int, semitones: int) -> messages.RpnSet: ...
def tuning_program(*, channel: int, program: int) -> messages.RpnSet: ...
def tuning_bank(*, channel: int, bank: int) -> messages.RpnSet: ...
def modulation_depth_range(*, channel: int, value: int) -> messages.RpnSet: ...
def all_sound_off(*, channel: int) -> messages.ControlChange: ...
def reset_all_controllers(*, channel: int) -> messages.ControlChange: ...
def local_control(*, channel: int, enabled: bool) -> messages.ControlChange: ...
def all_notes_off(*, channel: int) -> messages.ControlChange: ...
def omni_off(*, channel: int) -> messages.ControlChange: ...
def omni_on(*, channel: int) -> messages.ControlChange: ...
def mono_mode(*, channel: int, channels: int) -> messages.ControlChange: ...
def poly_mode(*, channel: int) -> messages.ControlChange: ...

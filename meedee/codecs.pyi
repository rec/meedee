"""MIDI 1.0 streams, without timestamps, transport or Standard MIDI File rules."""

from enum import Enum

from . import messages
from .messages import Message

def encode(message: Message) -> bytes: ...
def expand(
    command: messages.ControlChange14
    | messages.RpnSet
    | messages.NrpnSet
    | messages.RpnIncrement
    | messages.RpnDecrement
    | messages.NrpnIncrement
    | messages.NrpnDecrement,
) -> list[messages.ControlChange]: ...

class Decoder:
    def __init__(self, *, sysex_limit: int = 1048576) -> None: ...
    @property
    def sysex_limit(self) -> int: ...
    def feed(
        self, data: bytes | bytearray | memoryview
    ) -> list[Message | Diagnostic]: ...
    def finish(self) -> list[Message | Diagnostic]: ...
    def reset(self) -> None: ...

class Diagnostic:
    @property
    def kind(self) -> DiagnosticKind: ...
    @property
    def offset(self) -> int: ...
    @property
    def byte(self) -> int | None: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...

class DiagnosticKind(Enum):
    UnexpectedData = ...
    UndefinedStatus = ...
    UnexpectedEnd = ...
    InterruptedMessage = ...
    InterruptedSysEx = ...
    SysExTooLarge = ...
    TruncatedMessage = ...
    TruncatedSysEx = ...

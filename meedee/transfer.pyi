from os import PathLike
from typing import BinaryIO

from . import events
from .messages import SysEx

class Plan:
    def __init__(
        self,
        messages: list[SysEx],
        *,
        gap_ns: int,
        message_limit: int = 256,
        byte_limit: int = 8_388_608,
    ) -> None: ...
    @property
    def message_count(self) -> int: ...
    @property
    def wire_bytes(self) -> int: ...
    @property
    def gap_ns(self) -> int: ...
    def message(self, index: int) -> SysEx: ...

class Step:
    @property
    def index(self) -> int: ...
    @property
    def message(self) -> SysEx: ...

class Report:
    @property
    def status(self) -> str: ...
    @property
    def total_messages(self) -> int: ...
    @property
    def total_bytes(self) -> int: ...
    @property
    def confirmed_messages(self) -> int: ...
    @property
    def confirmed_bytes(self) -> int: ...
    @property
    def remaining_messages(self) -> int: ...
    @property
    def in_flight(self) -> int | None: ...
    @property
    def uncertain_message(self) -> int | None: ...
    @property
    def next_ready_ns(self) -> int | None: ...
    @property
    def reason(self) -> str | None: ...

class Session:
    def __init__(self, plan: Plan) -> None: ...
    def prepare(self, now_ns: int) -> Step | None: ...
    def confirm(self, index: int, now_ns: int) -> None: ...
    def fail(self, index: int, reason: str) -> None: ...
    def cancel(self, reason: str) -> None: ...
    def snapshot(self) -> Report: ...

def read_file(
    source: str | PathLike[str] | BinaryIO,
    *,
    gap_ns: int,
    message_limit: int = 256,
    byte_limit: int = 8_388_608,
    payload_limit: int = 1_048_576,
) -> Plan: ...

class CaptureReport:
    @property
    def status(self) -> str: ...
    @property
    def expected_messages(self) -> int: ...
    @property
    def received_messages(self) -> int: ...
    @property
    def wire_bytes(self) -> int: ...
    @property
    def ignored_events(self) -> int: ...
    @property
    def deadline_ns(self) -> int | None: ...
    @property
    def reason(self) -> str | None: ...

class Capture:
    def __init__(
        self,
        *,
        stream: str,
        expected_messages: int,
        timeout_ns: int,
        byte_limit: int = 8_388_608,
        payload_limit: int = 1_048_576,
    ) -> None: ...
    def start(self, now_ns: int) -> None: ...
    def poll(self, now_ns: int) -> None: ...
    def feed(
        self, item: events.Event | events.StreamDiagnostic, now_ns: int
    ) -> None: ...
    def fail(self, reason: str) -> None: ...
    def cancel(self, reason: str) -> None: ...
    def snapshot(self) -> CaptureReport: ...
    def message(self, index: int) -> SysEx: ...
    def write(self, destination: str | PathLike[str] | BinaryIO) -> None: ...

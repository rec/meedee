"""MTS exact values. Device IDs and tuning banks/programs are 0–127."""

from enum import Enum

from . import events, messages

class Pitch:
    def __init__(self, *, semitone: int, fraction: int) -> None: ...
    @property
    def semitone(self) -> int: ...
    @property
    def fraction(self) -> int: ...
    @property
    def frequency_hz(self) -> float: ...
    @staticmethod
    def from_frequency(*, frequency_hz: float) -> PitchConversion: ...
    @staticmethod
    def from_cents(*, note: int, cents: float) -> PitchConversion: ...
    def replace(self, *, semitone: int = ..., fraction: int = ...) -> Pitch: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...

class NoChange:
    def __init__(self) -> None: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...

class TuningTable:
    def __init__(
        self, *, values: list[Pitch | NoChange] | tuple[Pitch | NoChange, ...]
    ) -> None: ...
    @property
    def values(self) -> tuple[Pitch | NoChange, ...]: ...
    def replace(
        self, *, values: list[Pitch | NoChange] | tuple[Pitch | NoChange, ...] = ...
    ) -> TuningTable: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...

class NoteTuning:
    def __init__(self, *, note: int, pitch: Pitch | NoChange) -> None: ...
    @property
    def note(self) -> int: ...
    @property
    def pitch(self) -> Pitch | NoChange: ...
    def replace(
        self, *, note: int = ..., pitch: Pitch | NoChange = ...
    ) -> NoteTuning: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...

class ScaleOffsets:
    def __init__(
        self, *, resolution: int, values: list[int] | tuple[int, ...]
    ) -> None: ...
    @property
    def resolution(self) -> int: ...
    @property
    def values(self) -> tuple[int, ...]: ...
    @staticmethod
    def from_cents(
        *, resolution: int, cents: list[float] | tuple[float, ...]
    ) -> ScaleConversion: ...
    def replace(
        self, *, resolution: int = ..., values: list[int] | tuple[int, ...] = ...
    ) -> ScaleOffsets: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...

class PitchConversion:
    @property
    def pitch(self) -> Pitch: ...
    @property
    def error_cents(self) -> float: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...

class ScaleConversion:
    @property
    def offsets(self) -> ScaleOffsets: ...
    @property
    def error_cents(self) -> tuple[float, ...]: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...


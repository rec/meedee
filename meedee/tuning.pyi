class ChecksumStatus(Enum):
    NotPresent = ...
    Matches = ...
    LegacyMismatch = ...

class Decoded:
    @property
    def message(
        self,
    ) -> (
        BulkDumpRequest
        | BankedDumpRequest
        | BulkDump
        | KeyBasedDump
        | ScaleOctaveDump
        | SingleNoteChange
        | BankedNoteChange
        | ScaleOctaveChange
    ): ...
    @property
    def checksum(self) -> ChecksumStatus: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...

def decode(message: messages.SysEx) -> Decoded | None: ...

class RequestStatus(Enum):
    Pending = ...
    Completed = ...
    TimedOut = ...
    Cancelled = ...

class ReplyTracker:
    def __init__(
        self,
        *,
        request: BulkDumpRequest | BankedDumpRequest,
        now_ns: int,
        timeout_ns: int,
    ) -> None: ...
    @property
    def status(self) -> RequestStatus: ...
    @property
    def deadline_ns(self) -> int: ...
    def poll(self, *, now_ns: int) -> RequestStatus: ...
    def cancel(self) -> RequestStatus: ...
    def observe(
        self,
        message: BulkDumpRequest
        | BankedDumpRequest
        | BulkDump
        | KeyBasedDump
        | ScaleOctaveDump
        | SingleNoteChange
        | BankedNoteChange
        | ScaleOctaveChange,
        *,
        now_ns: int,
    ) -> bool: ...

class EventDecoder:
    def __init__(self, *, group: int | None = None) -> None: ...
    def feed(
        self, value: events.Event | events.StreamDiagnostic
    ) -> list[events.Observation]: ...
    def feed_assembled(
        self, observation: events.Observation
    ) -> list[events.Observation]: ...
    def reset(self) -> None: ...

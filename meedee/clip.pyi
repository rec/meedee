"""MIDI Clip 1.0 (.midi2); all clock and configuration packets are explicit."""

from collections.abc import Iterator
from os import PathLike
from typing import BinaryIO

from . import events
from .messages import Message

class Entry:
    @property
    def tick(self) -> int | None: ...
    @property
    def sequence(self) -> bool: ...
    @property
    def message(self) -> Message: ...

class Reader:
    def __init__(
        self, source: str | PathLike[str] | BinaryIO, *, preserve_unknown: bool = False
    ) -> None: ...
    def close(self) -> None: ...
    def __iter__(self) -> Iterator[Entry]: ...
    def __next__(self) -> Entry: ...

class Writer:
    def __init__(self, destination: str | PathLike[str] | BinaryIO) -> None: ...
    def write(self, message: Message) -> None: ...
    def finish(self) -> None: ...

class TimedReader:
    def __init__(
        self,
        source: str | PathLike[str] | BinaryIO,
        *,
        stream: str,
        include_configuration: bool = False,
    ) -> None: ...
    @property
    def clock(self) -> events.Clock: ...
    @property
    def origin(self) -> events.Timestamp: ...
    def __iter__(self) -> Iterator[events.Event | events.StreamDiagnostic]: ...
    def __next__(self) -> events.Event | events.StreamDiagnostic: ...
    def close(self) -> None: ...

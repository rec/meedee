"""Immutable events and explicit clocks; transport nanoseconds do not imply accuracy."""

from . import messages, metrics, midi

class Clock:
    def __init__(
        self,
        *,
        identity: str,
        backend: midi.Backend | None = None,
        mode: midi.TimestampMode | None = None,
        tick_numerator: int = 1,
        tick_denominator: int = 1_000_000_000,
        origin: str | None = None,
        resolution_ticks: int | None = None,
    ) -> None: ...
    @property
    def identity(self) -> str: ...
    @property
    def backend(self) -> midi.Backend | None: ...
    @property
    def mode(self) -> midi.TimestampMode | None: ...
    @property
    def tick_numerator(self) -> int: ...
    @property
    def tick_denominator(self) -> int: ...
    @property
    def resolution_ns(self) -> int | None: ...
    @property
    def origin(self) -> str: ...
    @property
    def resolution_ticks(self) -> int | None: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...

class ReceivedPacket:
    def __init__(
        self,
        *,
        timestamp_ns: int | None,
        clock: Clock,
        packet: bytes | bytearray | memoryview | midi.UmpPacket,
        sequence: int | None = None,
    ) -> None: ...
    @property
    def timestamp_ns(self) -> int | None: ...
    @property
    def sequence(self) -> int | None: ...
    @property
    def clock(self) -> Clock: ...
    @property
    def packet(self) -> bytes | midi.UmpPacket: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...

class Timestamp:
    def __init__(self, *, ticks: int, clock: Clock) -> None: ...
    @property
    def ticks(self) -> int: ...
    @property
    def clock(self) -> Clock: ...
    @property
    def seconds(self) -> Rational: ...
    def replace(self, **changes: object) -> Timestamp: ...

class SourceSpan:
    def __init__(
        self,
        *,
        first_packet: int,
        last_packet: int,
        first_timestamp: Timestamp | None = None,
        last_timestamp: Timestamp | None = None,
    ) -> None: ...
    @property
    def first_packet(self) -> int: ...
    @property
    def last_packet(self) -> int: ...
    @property
    def first_timestamp(self) -> Timestamp | None: ...
    @property
    def last_timestamp(self) -> Timestamp | None: ...
    def replace(self, **changes: object) -> SourceSpan: ...

class Event:
    def __init__(
        self,
        *,
        stream: str,
        message: messages.Message,
        timestamp: Timestamp | None = None,
        span: SourceSpan | None = None,
    ) -> None: ...
    @property
    def stream(self) -> str: ...
    @property
    def message(self) -> messages.Message: ...
    @property
    def timestamp(self) -> Timestamp | None: ...
    @property
    def span(self) -> SourceSpan | None: ...
    def replace(self, **changes: object) -> Event: ...

class Rational:
    def __init__(self, *, numerator: int, denominator: int) -> None: ...
    @property
    def numerator(self) -> int: ...
    @property
    def denominator(self) -> int: ...
    def round(self, *, allow_rounding: bool = False) -> tuple[int, Rational]: ...
    def replace(self, **changes: object) -> Rational: ...

class StreamDiagnostic:
    @property
    def stream(self) -> str: ...
    @property
    def packet(self) -> int: ...
    @property
    def kind(self) -> str: ...
    @property
    def lost(self) -> int: ...
    @property
    def reason(self) -> str: ...

class PacketDecoder:
    def __init__(
        self, *, stream: str, protocol: midi.Protocol, sysex_limit: int = 1_048_576
    ) -> None: ...
    def feed(self, packet: ReceivedPacket) -> list[Event | StreamDiagnostic]: ...
    def loss(self, *, lost: int, reason: str) -> StreamDiagnostic: ...
    @property
    def pending(self) -> bool: ...
    def reset(self) -> None: ...
    def finish(self) -> list[Event | StreamDiagnostic]: ...

class Cancellation:
    def __init__(self) -> None: ...
    def cancel(self) -> None: ...
    @property
    def cancelled(self) -> bool: ...

class ClockMapping:
    def __init__(
        self,
        *,
        source: Clock,
        target: Clock,
        rate: Rational | None = None,
        offset: Rational | None = None,
        uncertainty: Rational | None = None,
    ) -> None: ...
    @property
    def source(self) -> Clock: ...
    @property
    def target(self) -> Clock: ...
    @property
    def rate(self) -> Rational: ...
    @property
    def offset(self) -> Rational: ...
    @property
    def uncertainty(self) -> Rational | None: ...
    def map_time(self, timestamp: Timestamp) -> Rational: ...
    def replace(self, **changes: object) -> ClockMapping: ...

class PlannedEvent:
    @property
    def delay_ns(self) -> int: ...
    @property
    def rounding_error_ns(self) -> Rational: ...

class PlaybackPlan:
    def __init__(
        self,
        *,
        origin: Timestamp,
        mappings: list[ClockMapping] | tuple[ClockMapping, ...] | None = None,
        allow_rounding: bool = False,
    ) -> None: ...
    def deadline(self, event: Event) -> PlannedEvent: ...

class PlaybackReport:
    @property
    def lateness(self) -> metrics.Distribution | None: ...
    @property
    def sent_events(self) -> int: ...
    @property
    def cancelled(self) -> bool: ...
    @property
    def max_lateness_ns(self) -> int: ...
    @property
    def rounded_events(self) -> int: ...

class PlaybackError(Exception):
    completed_events: int
    report: PlaybackReport

class Observation:
    @property
    def stream(self) -> str: ...
    @property
    def group(self) -> int | None: ...
    @property
    def first_index(self) -> int | None: ...
    @property
    def last_index(self) -> int | None: ...
    @property
    def first_timestamp(self) -> Timestamp | None: ...
    @property
    def last_timestamp(self) -> Timestamp | None: ...
    @property
    def value(self) -> object: ...

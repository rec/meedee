"""Immutable transport events; timestamps have nanosecond units, not accuracy."""

from . import midi

class Clock:
    def __init__(
        self, *, identity: str, backend: midi.Backend, mode: midi.TimestampMode
    ) -> None: ...
    @property
    def identity(self) -> str: ...
    @property
    def backend(self) -> midi.Backend: ...
    @property
    def mode(self) -> midi.TimestampMode: ...
    @property
    def tick_numerator(self) -> int: ...
    @property
    def tick_denominator(self) -> int: ...
    @property
    def resolution_ns(self) -> int | None: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...

class ReceivedPacket:
    def __init__(
        self,
        *,
        timestamp_ns: int | None,
        clock: Clock,
        packet: bytes | bytearray | memoryview | midi.UmpPacket,
    ) -> None: ...
    @property
    def timestamp_ns(self) -> int | None: ...
    @property
    def clock(self) -> Clock: ...
    @property
    def packet(self) -> bytes | midi.UmpPacket: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...

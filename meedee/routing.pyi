from os import PathLike
from typing import BinaryIO, Literal

from . import events

class Route:
    def __init__(
        self,
        *,
        name: str,
        source: str,
        destination: str,
        protocol: Literal["midi1", "ump"],
        channel: int | None = None,
        group: int | None = None,
        remap_channel: int | None = None,
        remap_group: int | None = None,
        include_nonchannel: bool = False,
    ) -> None: ...
    @property
    def name(self) -> str: ...
    @property
    def source(self) -> str: ...
    @property
    def destination(self) -> str: ...
    @property
    def protocol(self) -> str: ...
    @property
    def channel(self) -> int | None: ...
    @property
    def group(self) -> int | None: ...
    @property
    def remap_channel(self) -> int | None: ...
    @property
    def remap_group(self) -> int | None: ...
    @property
    def include_nonchannel(self) -> bool: ...

class Router:
    def __init__(
        self,
        *,
        routes: list[Route],
        event_limit: int = 128,
        byte_limit: int = 8_388_608,
    ) -> None: ...
    def feed(self, item: events.Event | events.StreamDiagnostic) -> None: ...
    def peek(self) -> Delivery | None: ...
    def confirm(self, id: int) -> None: ...
    def fail(self, id: int, reason: str) -> None: ...
    def stop(self, reason: str) -> None: ...
    def snapshot(self) -> Report: ...

class Delivery:
    @property
    def id(self) -> int: ...
    @property
    def route(self) -> str: ...
    @property
    def destination(self) -> str: ...
    @property
    def event(self) -> events.Event: ...
    @property
    def wire_bytes(self) -> int: ...

class Report:
    @property
    def received(self) -> int: ...
    @property
    def filtered(self) -> int: ...
    @property
    def admitted(self) -> int: ...
    @property
    def confirmed(self) -> int: ...
    @property
    def capacity_rejections(self) -> int: ...
    @property
    def pending(self) -> int: ...
    @property
    def queued_bytes(self) -> int: ...
    @property
    def stopped(self) -> bool: ...
    @property
    def reason(self) -> str | None: ...
    @property
    def uncertain_delivery(self) -> int | None: ...
    @property
    def uncertain_route(self) -> str | None: ...
    @property
    def uncertain_destination(self) -> str | None: ...
    @property
    def routes(self) -> dict[str, dict[str, int]]: ...

class Preview:
    @property
    def complete(self) -> bool: ...
    @property
    def problem(self) -> str | None: ...
    @property
    def records(self) -> int: ...
    @property
    def routing(self) -> Report: ...
    @property
    def examples(self) -> list[Delivery]: ...
    @property
    def omitted_examples(self) -> int: ...

def preview_file(
    source: str | PathLike[str] | BinaryIO,
    *,
    routes: list[Route],
    event_limit: int = 128,
    byte_limit: int = 8_388_608,
    payload_limit: int = 1_048_576,
    detail_limit: int = 128,
) -> Preview: ...

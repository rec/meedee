class Distribution:
    @property
    def count(self) -> int: ...
    @property
    def sum_ns(self) -> int: ...
    @property
    def minimum_ns(self) -> int | None: ...
    @property
    def maximum_ns(self) -> int | None: ...
    @property
    def upper_bounds_ns(self) -> list[int]: ...
    @property
    def buckets(self) -> list[int]: ...

class Histogram:
    def __init__(self) -> None: ...
    def observe(self, nanoseconds: int | str) -> None: ...
    def snapshot(self) -> Distribution: ...

class Pressure:
    @property
    def accepted_records(self) -> int: ...
    @property
    def capacity_rejections(self) -> int: ...
    @property
    def peak_reserved_records(self) -> int: ...
    @property
    def peak_reserved_bytes(self) -> int: ...

class DeliveryReport:
    @property
    def events(self) -> int: ...
    @property
    def elapsed_ns(self) -> int: ...
    @property
    def intervals(self) -> Distribution: ...

class Delivery:
    def __init__(self, *, start_ns: int | str) -> None: ...
    def observe(self, now_ns: int | str) -> None: ...
    def snapshot(self, now_ns: int | str) -> DeliveryReport: ...

"""Pure mpe values backed by the shared Rust toolkit."""

from . import events, messages

class ZoneConfiguration(messages.Message):
    def __init__(self, *, manager_channel: int, members: int) -> None: ...
    @property
    def manager_channel(self) -> int: ...
    @property
    def members(self) -> int: ...
    def replace(
        self, *, manager_channel: int = ..., members: int = ...
    ) -> ZoneConfiguration: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...

class Voice:
    @property
    def id(self) -> int: ...
    @property
    def channel(self) -> int: ...
    @property
    def note(self) -> int: ...
    @property
    def velocity(self) -> int: ...
    @property
    def note_on(self) -> messages.NoteOn: ...

class Allocator:
    def __init__(self, *, zone: ZoneConfiguration) -> None: ...
    def allocate(self, *, note: int, velocity: int) -> Voice: ...
    def release(self, *, voice_id: int, velocity: int) -> messages.NoteOff: ...
    def set_sustain(self, *, enabled: bool) -> messages.ControlChange: ...
    def reset(self) -> None: ...

class NoteState:
    @property
    def note(self) -> int: ...
    @property
    def held(self) -> int: ...
    @property
    def sustained(self) -> int: ...

class ChannelState:
    @property
    def channel(self) -> int: ...
    @property
    def notes(self) -> list[NoteState]: ...
    @property
    def pitch_bend(self) -> int | None: ...
    @property
    def pressure(self) -> int | None: ...
    @property
    def timbre(self) -> int | None: ...
    @property
    def sustain(self) -> bool | None: ...
    @property
    def ambiguous(self) -> bool: ...

class Tracker:
    def __init__(self, *, zone: ZoneConfiguration) -> None: ...
    def configure(self, *, zone: ZoneConfiguration) -> None: ...
    def reset(self) -> None: ...
    def feed(self, message: messages.Message) -> list[ChannelState]: ...
    def snapshot(self, *, channel: int) -> ChannelState: ...

class EventTracker:
    def __init__(
        self, *, zone: ZoneConfiguration, group: int | None = None
    ) -> None: ...
    def feed(
        self, value: events.Event | events.StreamDiagnostic
    ) -> list[events.Observation]: ...
    def reset(self) -> None: ...
    def snapshot(self, *, channel: int) -> ChannelState: ...

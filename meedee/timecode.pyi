"""Pure timecode values backed by the shared Rust toolkit."""

from enum import Enum

from . import events, messages

class FrameRate(Enum):
    Fps24 = ...
    Fps25 = ...
    DropFrame30 = ...
    Fps30 = ...

class FullFrame(messages.Message):
    def __init__(
        self,
        *,
        device_id: int,
        rate: FrameRate,
        hours: int,
        minutes: int,
        seconds: int,
        frames: int,
    ) -> None: ...
    @property
    def device_id(self) -> int: ...
    @property
    def rate(self) -> FrameRate: ...
    @property
    def hours(self) -> int: ...
    @property
    def minutes(self) -> int: ...
    @property
    def seconds(self) -> int: ...
    @property
    def frames(self) -> int: ...
    def replace(
        self,
        *,
        device_id: int = ...,
        rate: FrameRate = ...,
        hours: int = ...,
        minutes: int = ...,
        seconds: int = ...,
        frames: int = ...,
    ) -> FullFrame: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...

def decode(message: messages.SysEx) -> FullFrame | None: ...

class Position:
    def __init__(
        self, *, rate: FrameRate, hours: int, minutes: int, seconds: int, frames: int
    ) -> None: ...
    @property
    def rate(self) -> FrameRate: ...
    @property
    def hours(self) -> int: ...
    @property
    def minutes(self) -> int: ...
    @property
    def seconds(self) -> int: ...
    @property
    def frames(self) -> int: ...
    def advance(self, *, frames: int) -> Position: ...
    def replace(self, **changes: object) -> Position: ...

class AssemblyDiagnostic(Enum):
    Discontinuity = ...
    Malformed = ...
    Timeout = ...
    Relocated = ...
    Reset = ...

class TimecodeObservation:
    @property
    def encoded(self) -> Position: ...
    @property
    def compensated(self) -> Position: ...
    @property
    def direction(self) -> int: ...
    @property
    def locked(self) -> bool: ...

class AssemblyResult:
    @property
    def observation(self) -> TimecodeObservation | None: ...
    @property
    def diagnostic(self) -> AssemblyDiagnostic | None: ...

class Assembler:
    def __init__(self, *, timeout_ns: int) -> None: ...
    @property
    def locked(self) -> bool: ...
    def reset(self) -> None: ...
    def feed(
        self, message: messages.Message | FullFrame, *, now_ns: int
    ) -> AssemblyResult: ...
    def poll(self, *, now_ns: int) -> AssemblyDiagnostic | None: ...

class EventAssembler:
    def __init__(self, *, timeout_ns: int, group: int | None = None) -> None: ...
    def feed(
        self, value: events.Event | events.StreamDiagnostic, *, now_ns: int
    ) -> list[events.Observation]: ...
    def poll(self, *, now_ns: int) -> list[events.Observation]: ...
    def reset(self) -> None: ...

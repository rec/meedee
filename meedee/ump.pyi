class DecodeDiagnostic:
    @property
    def word_offset(self) -> int: ...
    @property
    def reason(self) -> str: ...

class Decoder:
    def __init__(self, *, preserve_unknown: bool = False) -> None: ...
    def feed(
        self, words: list[int] | tuple[int, ...]
    ) -> list[Message | DecodeDiagnostic]: ...
    def finish(self) -> list[Message | DecodeDiagnostic]: ...
    def reset(self) -> None: ...

class DataKind(Enum):
    SysEx7 = ...
    SysEx8 = ...
    FlexData = ...
    StreamText = ...

class AssemblyDiagnostic(Enum):
    Interrupted = ...
    UnexpectedContinuation = ...
    Aborted = ...
    PayloadLimit = ...
    StreamLimit = ...
    MalformedText = ...
    TooManyPackets = ...
    Truncated = ...

class AssembledData:
    @property
    def kind(self) -> DataKind: ...
    @property
    def group(self) -> int | None: ...
    @property
    def channel(self) -> int | None: ...
    @property
    def stream_id(self) -> int | None: ...
    @property
    def function_block(self) -> int | None: ...
    @property
    def status_bank(self) -> int | None: ...
    @property
    def status(self) -> int | None: ...
    @property
    def data(self) -> bytes: ...
    @property
    def text(self) -> str | None: ...

class Assembler:
    def __init__(
        self,
        *,
        message_limit: int = 1_048_576,
        total_limit: int = 8_388_608,
        max_streams: int = 64,
    ) -> None: ...
    @property
    def retained_bytes(self) -> int: ...
    @property
    def active_streams(self) -> int: ...
    def feed(self, message: Message) -> list[AssembledData | AssemblyDiagnostic]: ...
    def finish(self) -> list[AssembledData | AssemblyDiagnostic]: ...
    def reset(self) -> None: ...

class TranslationStatus(Enum):
    Exact = ...
    Quantized = ...
    Unsupported = ...
    ProfileDependent = ...
    ContextRequired = ...

class Translation:
    @property
    def status(self) -> TranslationStatus: ...
    @property
    def reason(self) -> str: ...
    @property
    def group(self) -> int | None: ...
    @property
    def converted(self) -> bool: ...
    @property
    def messages(self) -> list[Message]: ...

class Capabilities:
    def __init__(self, *, midi1: bool, midi2: bool, sysex8_streams: int) -> None: ...
    @property
    def midi1(self) -> bool: ...
    @property
    def midi2(self) -> bool: ...
    @property
    def sysex8_streams(self) -> int: ...
    def supports(self, message: Message) -> bool | None: ...
    def replace(self, **changes: object) -> Capabilities: ...


"""Caller-driven test connections. Receive never waits or advances a clock."""

from types import TracebackType
from typing import Literal, Self

from . import events, messages, midi

class ManualClock:
    def __init__(self, *, now_ns: int = 0) -> None: ...
    @property
    def now_ns(self) -> int: ...
    def advance(self, nanoseconds: int) -> None: ...

class Input:
    def __init__(
        self,
        *,
        stream: str,
        protocol: Literal["midi1", "ump"],
        packet_limit: int = 128,
        event_limit: int = 128,
        byte_limit: int = 8_388_608,
        sysex_limit: int = 1_048_576,
    ) -> None: ...
    def inject(
        self,
        packet: bytes | bytearray | memoryview | midi.UmpPacket,
        *,
        clock: events.Clock,
        timestamp_ns: int | None = None,
    ) -> bool: ...
    def receive(
        self, *, timeout: float | None = None, cancel: events.Cancellation | None = None
    ) -> events.Event | events.StreamDiagnostic | None: ...
    def lose(self, count: int) -> None: ...
    def fail(self, reason: str) -> None: ...
    def close(self) -> None: ...
    @property
    def stream(self) -> str: ...
    @property
    def dropped_packets(self) -> int: ...
    @property
    def closed(self) -> bool: ...
    @property
    def failure(self) -> Exception | None: ...
    def snapshot(self) -> InputReport: ...
    def __enter__(self) -> Self: ...
    def __exit__(
        self,
        kind: type[BaseException] | None,
        value: BaseException | None,
        traceback: TracebackType | None,
    ) -> None: ...

class InputReport:
    @property
    def next_sequence(self) -> int: ...
    @property
    def dropped_packets(self) -> int: ...
    @property
    def dropped_events(self) -> int: ...
    @property
    def queued_packets(self) -> int: ...
    @property
    def queued_events(self) -> int: ...
    @property
    def queued_bytes(self) -> int: ...
    @property
    def closed(self) -> bool: ...
    @property
    def failure(self) -> str | None: ...

class Output:
    def __init__(
        self,
        *,
        protocol: Literal["midi1", "ump"],
        packet_limit: int = 128,
        byte_limit: int = 8_388_608,
    ) -> None: ...
    def send(self, packet: bytes | bytearray | memoryview | midi.UmpPacket) -> None: ...
    def send_message(self, message: messages.Message) -> None: ...
    def fail_next_send(
        self, *, accepted: bool = False, reason: str = "simulated send failure"
    ) -> None: ...
    def take_packet(self) -> bytes | midi.UmpPacket | None: ...
    def close(self) -> None: ...
    @property
    def closed(self) -> bool: ...
    def snapshot(self) -> OutputReport: ...
    def __enter__(self) -> Self: ...
    def __exit__(
        self,
        kind: type[BaseException] | None,
        value: BaseException | None,
        traceback: TracebackType | None,
    ) -> None: ...

class OutputReport:
    @property
    def attempts(self) -> int: ...
    @property
    def accepted(self) -> int: ...
    @property
    def queued_packets(self) -> int: ...
    @property
    def queued_bytes(self) -> int: ...
    @property
    def closed(self) -> bool: ...
    @property
    def failure(self) -> str | None: ...

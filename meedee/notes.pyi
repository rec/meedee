"""Counts describe observed traffic since a boundary, not sounding voices."""

from . import events

class Tracker:
    def __init__(self, *, stream: str, detail_limit: int = 128) -> None: ...
    def feed(self, item: events.Event | events.StreamDiagnostic) -> None: ...
    def invalidate(self) -> None: ...
    def snapshot(self) -> Report: ...

class Report:
    @property
    def channels(self) -> list[ChannelState]: ...
    @property
    def omitted_events(self) -> int: ...
    @property
    def boundaries(self) -> int: ...

class ChannelState:
    @property
    def source(self) -> str: ...
    @property
    def group(self) -> int | None: ...
    @property
    def channel(self) -> int: ...
    @property
    def protocol(self) -> str: ...
    @property
    def notes(self) -> list[NoteState]: ...
    @property
    def sustain(self) -> int | None: ...
    @property
    def sostenuto(self) -> int | None: ...
    @property
    def unmatched_releases(self) -> int: ...
    @property
    def uncertain(self) -> bool: ...

class NoteState:
    @property
    def note(self) -> int: ...
    @property
    def held(self) -> int: ...
    @property
    def released(self) -> int: ...

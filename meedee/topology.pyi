from typing import Literal

class Endpoint:
    def __init__(
        self,
        *,
        backend: str,
        protocol: Literal["midi1", "ump"],
        direction: Literal["input", "output"],
        backend_id: int,
        name: str,
    ) -> None: ...
    @property
    def backend(self) -> str: ...
    @property
    def protocol(self) -> str: ...
    @property
    def direction(self) -> str: ...
    @property
    def backend_id(self) -> int: ...
    @property
    def name(self) -> str: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...

class PortCount:
    @property
    def endpoint(self) -> Endpoint: ...
    @property
    def count(self) -> int: ...

class Change:
    @property
    def kind(self) -> str: ...
    @property
    def endpoint(self) -> Endpoint: ...
    @property
    def count(self) -> int: ...

class Delta:
    @property
    def generation(self) -> int: ...
    @property
    def added(self) -> int: ...
    @property
    def removed(self) -> int: ...
    @property
    def changes(self) -> list[Change]: ...
    @property
    def omitted_changes(self) -> int: ...

class Report:
    @property
    def generation(self) -> int: ...
    @property
    def port_count(self) -> int: ...
    @property
    def ports(self) -> list[PortCount]: ...
    @property
    def last(self) -> Delta | None: ...
    @property
    def history(self) -> list[Delta]: ...
    @property
    def omitted_history(self) -> int: ...
    @property
    def stopped(self) -> bool: ...
    @property
    def reason(self) -> str | None: ...

class Tracker:
    def __init__(
        self,
        *,
        port_limit: int = 256,
        detail_limit: int = 128,
        history_limit: int = 128,
    ) -> None: ...
    def observe(self, ports: list[Endpoint]) -> Report: ...
    def stop(self, reason: str) -> None: ...
    def snapshot(self) -> Report: ...

from collections.abc import Callable
from types import ModuleType

from . import ci, events, inspection, sysex, topology, tuning, universal

def run_identify(
    receiver: object,
    output: object,
    device_id: int,
    timeout: float | str,
    message_limit: int,
    byte_limit: int | str,
    payload_limit: int | str,
    cancel: events.Cancellation,
    now: Callable[[], int],
) -> universal.IdentityReport: ...
def run_monitor(
    monitor: inspection.Monitor,
    receiver: object,
    callback: Callable[[inspection.MonitorEntry], None] | None,
    duration: float | str | None,
    cancel: events.Cancellation,
    now: Callable[[], int],
    metrics: bool,
) -> inspection.MonitorReport: ...

class DiscoveryPollState:
    def __init__(
        self, encoding: str, port_limit: int, detail_limit: int, history_limit: int
    ) -> None: ...
    def poll(self, ports: Callable[[str], object]) -> topology.Report: ...
    def snapshot(self) -> topology.Report: ...
    @property
    def closed(self) -> bool: ...
    def close(self) -> None: ...


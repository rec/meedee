"""Observed state, with explicit unknown and partial values."""

from enum import Enum

from . import controls, events, messages, mpe, tuning
from .mpe import ChannelState
from .timecode import TimecodeObservation

class Retention(Enum):
    Full = ...
    Minimum = ...

class Category(Enum):
    Controls = ...
    Performance = ...
    Notes = ...
    System = ...

class Scope:
    def __init__(self, *, group: int | None = None, version: int = 1) -> None: ...
    @property
    def group(self) -> int | None: ...
    @property
    def version(self) -> int: ...

class CacheOptions:
    def __init__(
        self,
        *,
        default: Retention = Retention.Full,
        universe: Retention | None = None,
        categories: dict[Category, Retention] | None = None,
    ) -> None: ...
    def effective(self, category: Category) -> Retention: ...

class ControllerState:
    @property
    def scope(self) -> Scope: ...
    @property
    def channel(self) -> int: ...
    @property
    def controller(self) -> int: ...
    @property
    def coarse(self) -> int | None: ...
    @property
    def fine(self) -> int | None: ...
    @property
    def native(self) -> int | None: ...

class CachedParameter:
    @property
    def scope(self) -> Scope: ...
    @property
    def channel(self) -> int: ...
    @property
    def family(self) -> controls.ParameterFamily: ...
    @property
    def parameter(self) -> int: ...
    @property
    def components(self) -> controls.ParameterState | None: ...
    @property
    def native(self) -> int | None: ...

class SelectionState:
    @property
    def scope(self) -> Scope: ...
    @property
    def channel(self) -> int: ...
    @property
    def active(self) -> controls.ParameterFamily | None: ...
    @property
    def rpn(self) -> controls.ParameterState: ...
    @property
    def nrpn(self) -> controls.ParameterState: ...

class ProgramState:
    @property
    def scope(self) -> Scope: ...
    @property
    def channel(self) -> int: ...
    @property
    def program(self) -> int | None: ...
    @property
    def pending_msb(self) -> int | None: ...
    @property
    def pending_lsb(self) -> int | None: ...
    @property
    def bank_msb(self) -> int | None: ...
    @property
    def bank_lsb(self) -> int | None: ...

class PerformanceState:
    @property
    def scope(self) -> Scope: ...
    @property
    def channel(self) -> int: ...
    @property
    def pitch_bend(self) -> int | None: ...
    @property
    def pressure(self) -> int | None: ...

class NoteState:
    @property
    def scope(self) -> Scope: ...
    @property
    def channel(self) -> int: ...
    @property
    def note(self) -> int: ...
    @property
    def held(self) -> bool | None: ...
    @property
    def velocity(self) -> int | None: ...
    @property
    def velocity_resolution(self) -> int | None: ...
    @property
    def pressure(self) -> int | None: ...
    @property
    def pitch_bend(self) -> int | None: ...
    @property
    def registered(self) -> dict[int, int]: ...
    @property
    def assignable(self) -> dict[int, int]: ...

class SystemState:
    @property
    def scope(self) -> Scope: ...
    @property
    def running(self) -> bool | None: ...
    @property
    def song(self) -> int | None: ...
    @property
    def position(self) -> int | None: ...
    @property
    def timecode(self) -> TimecodeObservation | None: ...
    @property
    def master_volume(self) -> dict[int, int]: ...
    @property
    def master_fine_tuning(self) -> dict[int, int]: ...
    @property
    def master_coarse_tuning(self) -> dict[int, int]: ...

class TuningState:
    @property
    def group(self) -> int | None: ...
    @property
    def device(self) -> int: ...
    @property
    def bank(self) -> int | None: ...
    @property
    def program(self) -> int: ...
    @property
    def notes(self) -> dict[int, tuning.Pitch | tuning.NoChange]: ...
    @property
    def offsets(self) -> tuning.ScaleOffsets | None: ...

class ChannelTuningState:
    @property
    def group(self) -> int | None: ...
    @property
    def device(self) -> int: ...
    @property
    def channel(self) -> int: ...
    @property
    def offsets(self) -> tuning.ScaleOffsets: ...

class Snapshot:
    @property
    def controllers(self) -> tuple[ControllerState, ...]: ...
    @property
    def parameters(self) -> tuple[CachedParameter, ...]: ...
    @property
    def selections(self) -> tuple[SelectionState, ...]: ...
    @property
    def programs(self) -> tuple[ProgramState, ...]: ...
    @property
    def performance(self) -> tuple[PerformanceState, ...]: ...
    @property
    def notes(self) -> tuple[NoteState, ...]: ...
    @property
    def system(self) -> tuple[SystemState, ...]: ...
    @property
    def tuning(self) -> tuple[TuningState, ...]: ...
    @property
    def channel_tuning(self) -> tuple[ChannelTuningState, ...]: ...
    @property
    def mpe(self) -> tuple[tuple[int | None, ChannelState], ...]: ...

class Universe:
    def __init__(
        self,
        *,
        options: CacheOptions | None = None,
        timecode_timeout: float | str = 1.0,
    ) -> None: ...
    def feed(
        self,
        event: messages.Message | events.StreamDiagnostic,
        *,
        now_ns: int | str | None = None,
    ) -> list[events.Observation]: ...
    def poll(self, *, now_ns: int | str | None = None) -> list[events.Observation]: ...
    def reset(self) -> None: ...
    def set_timecode_timeout(self, timeout: float | str) -> None: ...
    def configure_mpe(self, zone: mpe.ZoneConfiguration) -> None: ...
    def effective(self, category: Category) -> Retention: ...
    def snapshot(self) -> Snapshot: ...
    def parameter_state(
        self,
        scope: Scope,
        channel: int,
        family: controls.ParameterFamily,
        parameter: int,
    ) -> CachedParameter | None: ...
    def controller_state(
        self, scope: Scope, channel: int, controller: int
    ) -> ControllerState | None: ...
    def selection_state(self, scope: Scope, channel: int) -> SelectionState | None: ...
    def note_state(self, scope: Scope, channel: int, note: int) -> NoteState | None: ...
    def program_state(self, scope: Scope, channel: int) -> ProgramState | None: ...
    def performance_state(
        self, scope: Scope, channel: int
    ) -> PerformanceState | None: ...
    def system_state(self, scope: Scope) -> SystemState | None: ...
    def mpe_state(self, group: int | None, channel: int) -> mpe.ChannelState | None: ...
    def channel_tuning_state(
        self, group: int | None, device: int, channel: int
    ) -> ChannelTuningState | None: ...
    def tuning_state(
        self, group: int | None, device: int, bank: int | None, program: int
    ) -> TuningState | None: ...

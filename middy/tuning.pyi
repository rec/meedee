"""MTS exact values. Device IDs and tuning banks/programs are 0–127."""

from enum import Enum
from os import PathLike
from typing import TYPE_CHECKING, BinaryIO

if TYPE_CHECKING:
    from ufor.tuning import Tuning

from . import events, messages, midi

class Pitch:
    def __init__(self, *, semitone: int, fraction: int) -> None: ...
    @property
    def semitone(self) -> int: ...
    @property
    def fraction(self) -> int: ...
    @property
    def frequency_hz(self) -> float: ...
    @staticmethod
    def from_frequency(*, frequency_hz: float | str) -> PitchConversion: ...
    @staticmethod
    def from_cents(*, note: int, cents: float | str) -> PitchConversion: ...
    def replace(self, *, semitone: int = ..., fraction: int = ...) -> Pitch: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...

class NoChange:
    def __init__(self) -> None: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...

class TuningTable:
    def __init__(
        self, *, values: list[Pitch | NoChange] | tuple[Pitch | NoChange, ...]
    ) -> None: ...
    @property
    def values(self) -> tuple[Pitch | NoChange, ...]: ...
    def replace(
        self, *, values: list[Pitch | NoChange] | tuple[Pitch | NoChange, ...] = ...
    ) -> TuningTable: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...

class NoteTuning:
    def __init__(self, *, note: int, pitch: Pitch | NoChange) -> None: ...
    @property
    def note(self) -> int: ...
    @property
    def pitch(self) -> Pitch | NoChange: ...
    def replace(
        self, *, note: int = ..., pitch: Pitch | NoChange = ...
    ) -> NoteTuning: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...

class ScaleOffsets:
    def __init__(
        self, *, resolution: int, values: list[int] | tuple[int, ...]
    ) -> None: ...
    @property
    def resolution(self) -> int: ...
    @property
    def values(self) -> tuple[int, ...]: ...
    @staticmethod
    def from_cents(
        *, resolution: int, cents: list[float | str] | tuple[float | str, ...]
    ) -> ScaleConversion: ...
    def replace(
        self, *, resolution: int = ..., values: list[int] | tuple[int, ...] = ...
    ) -> ScaleOffsets: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...

class PitchConversion:
    @property
    def pitch(self) -> Pitch: ...
    @property
    def error_cents(self) -> float: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...

class ScaleConversion:
    @property
    def offsets(self) -> ScaleOffsets: ...
    @property
    def error_cents(self) -> tuple[float, ...]: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...

class BulkDumpRequest(messages.Message):
    def __init__(
        self, *, device_id: int, program: int, bank: int | None = None
    ) -> None: ...
    @property
    def bank(self) -> int | None: ...
    @property
    def device_id(self) -> int: ...
    @property
    def program(self) -> int: ...
    def replace(
        self,
        *,
        device_id: int = ...,
        program: int = ...,
        bank: int | None = ...,
        timestamp: events.Timestamp | None = ...,
        stream: str | None = ...,
        span: events.SourceSpan | None = ...,
    ) -> BulkDumpRequest: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...

class BulkDump(messages.Message):
    def __init__(
        self,
        *,
        device_id: int,
        program: int,
        name: str,
        table: TuningTable,
        bank: int | None = None,
    ) -> None: ...
    @property
    def device_id(self) -> int: ...
    @property
    def program(self) -> int: ...
    @property
    def name(self) -> str: ...
    @property
    def table(self) -> TuningTable: ...
    @property
    def bank(self) -> int | None: ...
    def replace(
        self,
        *,
        device_id: int = ...,
        program: int = ...,
        name: str = ...,
        table: TuningTable = ...,
        bank: int | None = ...,
        timestamp: events.Timestamp | None = ...,
        stream: str | None = ...,
        span: events.SourceSpan | None = ...,
    ) -> BulkDump: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...

class ScaleOctaveDump(messages.Message):
    def __init__(
        self,
        *,
        device_id: int,
        bank: int,
        program: int,
        name: str,
        offsets: ScaleOffsets,
    ) -> None: ...
    @property
    def device_id(self) -> int: ...
    @property
    def bank(self) -> int: ...
    @property
    def program(self) -> int: ...
    @property
    def name(self) -> str: ...
    @property
    def offsets(self) -> ScaleOffsets: ...
    def replace(
        self,
        *,
        device_id: int = ...,
        bank: int = ...,
        program: int = ...,
        name: str = ...,
        offsets: ScaleOffsets = ...,
        timestamp: events.Timestamp | None = ...,
        stream: str | None = ...,
        span: events.SourceSpan | None = ...,
    ) -> ScaleOctaveDump: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...

class NoteChange(messages.Message):
    def __init__(
        self,
        *,
        device_id: int,
        program: int,
        changes: list[NoteTuning] | tuple[NoteTuning, ...],
        bank: int | None = None,
        realtime: bool = True,
    ) -> None: ...
    @property
    def device_id(self) -> int: ...
    @property
    def program(self) -> int: ...
    @property
    def changes(self) -> tuple[NoteTuning, ...]: ...
    @property
    def bank(self) -> int | None: ...
    @property
    def realtime(self) -> bool: ...
    def replace(
        self,
        *,
        device_id: int = ...,
        program: int = ...,
        changes: list[NoteTuning] | tuple[NoteTuning, ...] = ...,
        bank: int | None = ...,
        realtime: bool = ...,
        timestamp: events.Timestamp | None = ...,
        stream: str | None = ...,
        span: events.SourceSpan | None = ...,
    ) -> NoteChange: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...

class ScaleOctaveChange(messages.Message):
    def __init__(
        self,
        *,
        device_id: int,
        realtime: bool,
        channels: list[int] | tuple[int, ...],
        offsets: ScaleOffsets,
    ) -> None: ...
    @property
    def device_id(self) -> int: ...
    @property
    def realtime(self) -> bool: ...
    @property
    def channels(self) -> tuple[int, ...]: ...
    @property
    def offsets(self) -> ScaleOffsets: ...
    def replace(
        self,
        *,
        device_id: int = ...,
        realtime: bool = ...,
        channels: list[int] | tuple[int, ...] = ...,
        offsets: ScaleOffsets = ...,
        timestamp: events.Timestamp | None = ...,
        stream: str | None = ...,
        span: events.SourceSpan | None = ...,
    ) -> ScaleOctaveChange: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...

class ChecksumStatus(Enum):
    NotPresent = ...
    Matches = ...
    LegacyMismatch = ...

class Decoded:
    @property
    def message(
        self,
    ) -> (
        BulkDumpRequest | BulkDump | ScaleOctaveDump | NoteChange | ScaleOctaveChange
    ): ...
    @property
    def checksum(self) -> ChecksumStatus: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...

def decode(message: messages.SysEx) -> Decoded | None: ...

class RequestStatus(Enum):
    Pending = ...
    Completed = ...
    TimedOut = ...
    Cancelled = ...

class ReplyTracker:
    def __init__(
        self,
        *,
        request: BulkDumpRequest,
        now_ns: int | str,
        timeout: float | str,
    ) -> None: ...
    @property
    def status(self) -> RequestStatus: ...
    @property
    def deadline_ns(self) -> int: ...
    def poll(self, *, now_ns: int | str) -> RequestStatus: ...
    def cancel(self) -> RequestStatus: ...
    def observe(
        self,
        message: BulkDumpRequest
        | BulkDump
        | ScaleOctaveDump
        | NoteChange
        | ScaleOctaveChange,
        *,
        now_ns: int | str,
    ) -> bool: ...

class Decoder:
    def __init__(self, *, group: int | None = None) -> None: ...
    def feed(
        self, value: messages.Message | events.StreamDiagnostic
    ) -> list[events.Observation]: ...
    def feed_assembled(
        self, observation: events.Observation
    ) -> list[events.Observation]: ...
    def reset(self) -> None: ...

class QueryReport:
    @property
    def status(self) -> str: ...
    @property
    def request_sent(self) -> bool: ...
    @property
    def uncertain_send(self) -> bool: ...
    @property
    def ignored_events(self) -> int: ...
    @property
    def deadline_ns(self) -> int | None: ...
    @property
    def reply(self) -> messages.SysEx | None: ...
    @property
    def decoded(self) -> Decoded | None: ...
    @property
    def reason(self) -> str | None: ...

class Query:
    def __init__(
        self,
        *,
        request: BulkDumpRequest,
        stream: str,
        timeout: float | str,
    ) -> None: ...
    def prepare(self, now_ns: int | str) -> messages.SysEx: ...
    def confirm(self, now_ns: int | str) -> None: ...
    def poll(self, now_ns: int | str) -> None: ...
    def feed(
        self, item: messages.Message | events.StreamDiagnostic, now_ns: int | str
    ) -> None: ...
    def fail(self, reason: str) -> None: ...
    def cancel(self, reason: str) -> None: ...
    def snapshot(self) -> QueryReport: ...
    def write(self, destination: str | PathLike[str] | BinaryIO) -> None: ...

def convert(source: Tuning, note: int) -> NoteTuning: ...
def bulk_dump(
    source: Tuning,
    *,
    notes: list[int],
    device_id: int,
    program: int = 0,
    name: str,
    bank: int | None = None,
) -> BulkDump: ...
def note_changes(
    result: list[NoteTuning],
    *,
    device_id: int,
    program: int,
    realtime: bool,
    bank: int | None = None,
) -> list[NoteChange]: ...
def query(
    query: Query,
    receiver: midi.Input,
    output: midi.Output,
    *,
    cancel: events.Cancellation | None = None,
) -> QueryReport: ...
